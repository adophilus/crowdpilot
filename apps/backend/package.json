{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@crowdpilot/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env.development ./scripts/start.ts",
    "start": "tsx --env-file-if-exists=../../.env.development ./scripts/start.ts",
    "seed": "tsx --env-file-if-exists=../../.env.development ./scripts/seed.ts",
