# Copy to .env.development. Secrets are placeholders in dev; the server boots
# with them but external calls (Qloo/Onscript/LLM) will 401 until real values
# land. Production values come from the sops-encrypted env in infra/.
NODE_ENV=development
QLOO_API_KEY=dev-placeholder
QLOO_BASE_URL=https://hackathon.api.qloo.com
ONSCRIPT_BASE_URL=https://staging.onscript.example
ONSCRIPT_SESSION_TOKEN=dev-placeholder
OWNER_TOKEN=dev-owner-token
LLM_API_KEY=dev-placeholder
# LLM_BASE_URL=
