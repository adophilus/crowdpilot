# Copy to .env.development. Secrets are placeholders in dev; the server boots
# with them but external calls (Qloo/Onscript/LLM/SMTP) will fail until real
# values land. Production values come from the sops-encrypted env in infra/.
NODE_ENV=development
PORT=1050
DATABASE_URL=postgres://crowdpilot:crowdpilot@127.0.0.1:5432/crowdpilot
SMTP_HOST=smtp.purelymail.com
SMTP_PORT=587
SMTP_USER=hackathons@adophilus.com
SMTP_PASS=<see sops env>
QLOO_API_KEY=dev-placeholder
QLOO_BASE_URL=https://hackathon.api.qloo.com
ONSCRIPT_BASE_URL=https://staging.onscript.example
ONSCRIPT_SESSION_TOKEN=dev-placeholder
LLM_API_KEY=dev-placeholder
# LLM_BASE_URL=
