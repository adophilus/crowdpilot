# CrowdPilot backend secrets — TEMPLATE. Copy to secrets.env, fill real
# values, then sops-encrypt (docs/deploy-notes.md § Secrets). NEVER commit
# real secrets in plaintext: only sops-encrypted files may hold them here.
PORT=1050
NODE_ENV=production
DATABASE_URL=postgres://crowdpilot:CHANGE_ME@127.0.0.1:5432/crowdpilot
QLOO_API_KEY=CHANGE_ME
QLOO_BASE_URL=https://hackathon.api.qloo.com
ONSCRIPT_BASE_URL=https://api.onscript.xyz
ONSCRIPT_SESSION_TOKEN=CHANGE_ME
SMTP_HOST=smtp.purelymail.com
SMTP_PORT=587
SMTP_USER=hackathons@adophilus.com
SMTP_PASS=CHANGE_ME
LLM_API_KEY=CHANGE_ME
# Google OAuth — same client as dev; both redirect URIs are registered in the
# Google OAuth client "CrowdPilot" (project personal-gws-zenith).
GOOGLE_OAUTH_CLIENT_ID=CHANGE_ME
GOOGLE_OAUTH_CLIENT_SECRET=CHANGE_ME
GOOGLE_OAUTH_REDIRECT_URI=https://api.crowdpilot.hackathons.adophilus.com/auth/google/callback
# The Vercel web app origin + /auth/callback. Prod serves the app from the VPS:
# https://app.crowdpilot.hackathons.adophilus.com/auth/callback
AUTH_SUCCESS_REDIRECT=https://app.crowdpilot.hackathons.adophilus.com/auth/callback
